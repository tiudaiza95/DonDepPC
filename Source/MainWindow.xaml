<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dọn Dẹp PC 1.1" Width="1440" Height="880" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#F4F6FA"/><SolidColorBrush x:Key="Ink" Color="#1C2940"/><SolidColorBrush x:Key="Muted" Color="#64748B"/><SolidColorBrush x:Key="Panel" Color="#FFFFFF"/><SolidColorBrush x:Key="Soft" Color="#E9F0FF"/><SolidColorBrush x:Key="Header" Color="#F1F4F9"/><SolidColorBrush x:Key="Line" Color="#DFE5EF"/><SolidColorBrush x:Key="Stripe" Color="#FAFBFD"/><SolidColorBrush x:Key="Accent" Color="#2875F5"/><SolidColorBrush x:Key="AccentInk" Color="#2563D9"/><SolidColorBrush x:Key="Good" Color="#168569"/><SolidColorBrush x:Key="GoodSoft" Color="#E5F6EF"/>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Header}"/><Setter Property="Padding" Value="10,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Foreground="{DynamicResource Ink}" Background="{TemplateBinding Background}" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template><Grid Margin="10,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><ContentPresenter TextElement.Foreground="{DynamicResource Ink}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><TextBlock Grid.Column="1" Text="⌄"/></Grid></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="220"><ScrollViewer MaxHeight="340"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>


  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="Padding" Value="18,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="16,14"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Bg" CornerRadius="13" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Soft}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="RowBackground" Value="{DynamicResource Panel}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Stripe}"/><Setter Property="RowHeight" Value="52"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Header}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="6,8"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="12,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>

  <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="{DynamicResource Header}"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="16,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Background="{DynamicResource Canvas}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,20,14,16">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,12">
     <Button x:Name="CollapseSidebar" Content="☰" HorizontalAlignment="Left" Padding="9,5" ToolTip="Cài đặt &amp; Tiện ích hệ thống (☰)" Margin="0,0,0,12"/>
     <Image x:Name="BrandImage" Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,12"/>
     <TextBlock x:Name="BrandName" Text="Dọn Dẹp PC 1.1" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="BrandCaption" Text="CHĂM SÓC MÁY TÍNH · v1.1" FontSize="9" Foreground="{DynamicResource Muted}" Margin="1,5,0,0"/>
    </StackPanel>
    <Border x:Name="SidebarFoot" DockPanel.Dock="Bottom" Background="{DynamicResource Soft}" CornerRadius="15" Padding="15" Margin="0,20,0,0"><StackPanel><TextBlock Text="Thiết kế để bạn kiểm soát" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Xem trước mỗi lần dọn.&#10;Không tự xóa dữ liệu." Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="18" Margin="0,6,0,0"/><TextBlock Text="Phiên bản 1.1 · Desktop Pro Max" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,14,0,0"/></StackPanel></Border>
    <StackPanel>
     <Button x:Name="ToggleTheme" Content="◐  Sáng / Tối" Margin="0,0,0,8" Padding="10,9"/>
     <RadioButton x:Name="NavHealth" GroupName="Nav" Style="{StaticResource Nav}" Content="Tổng quan"/>
     <RadioButton x:Name="NavApps" GroupName="Nav" Style="{StaticResource Nav}" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Margin="0,2,13,0"/><TextBlock Text="Ứng dụng"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavTemp" Visibility="Collapsed" GroupName="Nav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,2,13,0"/><TextBlock Text="Dọn tệp tạm"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavLarge" Visibility="Collapsed" GroupName="Nav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDA2;" Margin="0,2,13,0"/><TextBlock Text="Tệp dung lượng lớn"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavStartup" GroupName="Nav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,2,13,0"/><TextBlock Text="Khởi động"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavDuplicates" Visibility="Collapsed" GroupName="Nav" Style="{StaticResource Nav}" Content="Tệp trùng nội dung"/>
     <RadioButton x:Name="NavTools" Visibility="Collapsed" GroupName="Nav" Style="{StaticResource Nav}" Content="Cập nhật &amp; lịch quét"/>
     <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Margin="0,2,13,0"/><TextBlock Text="Lịch sử &amp; khôi phục"/></StackPanel></RadioButton>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,20">
   <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition x:Name="StatsRow" Height="0"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
   <Grid><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="Heading" Text="Tổng quan hệ thống &amp; Giám sát hiệu năng" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/><TextBlock x:Name="Subtitle" Text="Cấu hình máy tính, giám sát tài nguyên thời gian thực và dọn dẹp hệ thống" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource GoodSoft}" CornerRadius="12" Padding="12,7" Margin="0,4,0,0"><StackPanel><TextBlock Text="●  Sẵn sàng" Foreground="{DynamicResource Good}" FontSize="11" x:Name="ReadyLabel"/><ProgressBar x:Name="BusyProgress" Height="3" Margin="0,5,0,0" IsIndeterminate="True" Visibility="Collapsed"/></StackPanel></Border></Grid>
   <Grid x:Name="GlobalStats" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,12,0"><StackPanel><TextBlock Text="ỨNG DỤNG DESKTOP" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="AppCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Danh sách đã lọc trùng" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,13" Margin="0,0,12,0"><StackPanel><TextBlock Text="NGUỒN ĐỌC ĐƯỢC GỘP" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="DuplicateCount" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}" Margin="0,3,0,0"/><TextBlock Text="Có thể mở xem từng nguồn" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,13"><StackPanel><TextBlock x:Name="DriveLabel" Text="DUNG LƯỢNG TRỐNG" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="DiskFree" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Good}" Margin="0,3,0,0"/><TextBlock Text="Ổ đĩa hệ thống" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Row="3">
    <Grid x:Name="AppsPage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><DockPanel>
      <Grid DockPanel.Dock="Top" Margin="16,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="290"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ListTitle" Text="Ứng dụng của bạn" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/><Border Grid.Column="1" Background="{DynamicResource Header}" CornerRadius="11" Margin="10,0"><Grid><TextBox x:Name="Search" AutomationProperties.Name="Tìm ứng dụng"/><TextBlock Text="Tìm ứng dụng…" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border><Button x:Name="RefreshApps" Grid.Column="2" Content="Làm mới" Padding="14,9"/></Grid>
      <StackPanel DockPanel.Dock="Top" Margin="16,0,16,10"><WrapPanel><ComboBox x:Name="AppFilter" Width="210" Margin="0,0,8,0"/><Button x:Name="ShowGroups" Content="Nguồn / nhóm trùng" Padding="12,9" Margin="0,0,8,0"/><TextBlock Text="Chọn nhiều bằng Ctrl/Shift · sắp xếp bằng tiêu đề cột" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></WrapPanel></StackPanel>
      <DataGrid x:Name="AppsGrid" IsReadOnly="True" SelectionMode="Extended" RowHeight="56"/>
     </DockPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14"><StackPanel>
      <TextBlock x:Name="SelectedApp" Text="Chọn ứng dụng bạn muốn gỡ" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="SelectedHint" Text="Bắt đầu bằng trình gỡ chính thức, sau đó kiểm tra phần dư." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,12" TextWrapping="Wrap"/>
      <WrapPanel><Button x:Name="AppInfo" Content="Thông tin" Margin="0,0,9,0"/><Button x:Name="Uninstall" Content="Gỡ mục đã chọn" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button x:Name="ForceUninstall" Content="⚡ Gỡ cưỡng chế" Margin="0,0,8,8"/><Button x:Name="BatchUninstall" Content="⚡ Gỡ hàng loạt" Margin="0,0,8,8"/><Button x:Name="SetupMonitorBtn" Content="📸 Giám sát cài đặt" Margin="0,0,8,8"/><Button x:Name="ScanRemnants" Content="Quét phần dư" Margin="0,0,8,8"/><Button x:Name="CleanRemnants" Content="Dọn mục đã chọn" Margin="0,0,8,8"/><Button x:Name="HistoryRemnants" Content="Phần dư đã ghi nhận" Margin="0,0,8,8"/></WrapPanel>
      <DataGrid x:Name="RemnantsGrid" Visibility="Collapsed" Height="115" RowHeight="36" Margin="0,12,0,0"><DataGrid.Columns><DataGridTemplateColumn Header="CHỌN" Width="65" MinWidth="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsEnabled="{Binding CanClean}" IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ĐƯỜNG DẪN CẦN KIỂM TRA" Binding="{Binding DisplayPath}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="LOẠI" Binding="{Binding Kind}" Width="210" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
     </StackPanel></Border>
    </Grid>
    <Grid x:Name="FilesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="FilesTitle" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="FilesHint" Margin="0,8,0,15" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20"/><WrapPanel><Button x:Name="ScanFiles" Style="{StaticResource Primary}" Content="Quét tệp tạm" Margin="0,0,9,0"/><Button x:Name="SelectFiles" Content="Chọn tất cả" Margin="0,0,9,0"/><Button x:Name="CleanFiles" Content="Dọn mục đã chọn" Margin="0,0,9,0"/><Button x:Name="OpenFileLocation" Content="Mở vị trí"/></WrapPanel></StackPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DockPanel><TextBlock x:Name="FilesSummary" DockPanel.Dock="Top" Text="Bấm Quét để xem trước kết quả." Margin="20,16" FontWeight="SemiBold"/><DataGrid x:Name="FilesGrid" RowHeight="48"><DataGrid.Columns><DataGridTemplateColumn Header="CHỌN" Width="65" MinWidth="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="TÊN TỆP" Binding="{Binding Name}" Width="220" MinWidth="220" IsReadOnly="True"/><DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding SizeLabel}" Width="110" MinWidth="110" IsReadOnly="True"/><DataGridTextColumn Header="ĐƯỜNG DẪN" Binding="{Binding Path}" Width="*" MinWidth="280" IsReadOnly="True"/></DataGrid.Columns></DataGrid></DockPanel></Border>
    </Grid>
    <Grid x:Name="StartupPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Chọn ứng dụng mở cùng Windows" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Quản lý mục Run của tài khoản hiện tại. Tắt một mục không gỡ phần mềm.&#10;Các mục khác được quản lý trong Cài đặt Windows." Foreground="{DynamicResource Muted}" Margin="0,8,0,15" LineHeight="20"/><WrapPanel><Button x:Name="ToggleStartup" Content="Tắt / bật mục đã chọn" Style="{StaticResource Primary}" Margin="0,0,9,0"/><Button x:Name="ManageServices" Content="⚙️ Dịch vụ bên thứ ba" Margin="0,0,9,0"/><Button x:Name="RegistryCleanBtn" Content="🧹 Dọn Registry" Margin="0,0,9,0"/><Button x:Name="WindowsStartup" Content="Mở Cài đặt Windows" Margin="0,0,9,0"/><Button x:Name="RefreshStartup" Content="Làm mới"/></WrapPanel></StackPanel></Border><Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="StartupGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ỨNG DỤNG" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="170"/><DataGridTextColumn Header="LỆNH KHỞI ĐỘNG" Binding="{Binding Command}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid>
    <Border x:Name="HistoryPage" Visibility="Collapsed" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Lịch sử rõ ràng. Có đường quay lại." FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Thư mục đã dọn nằm trong Thùng rác khi Windows hỗ trợ.&#10;Bản sao Registry cũ được giữ lại; khóa chưa đủ bằng chứng hiện chỉ được xem." Foreground="{DynamicResource Muted}" Margin="0,8,0,16" LineHeight="21"/><WrapPanel><Button x:Name="OpenBackups" Content="Bản sao Registry" Margin="0,0,9,0"/><Button x:Name="OpenRecycle" Content="Mở Thùng rác" Margin="0,0,9,0"/><Button x:Name="OpenLog" Content="Mở nhật ký" Margin="0,0,9,0"/><Button x:Name="RefreshHistory" Content="Làm mới"/></WrapPanel><Border Height="1" Background="{DynamicResource Line}" Margin="0,20"/></StackPanel><TextBox Foreground="{DynamicResource Ink}" x:Name="HistoryText" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></DockPanel></Border>
   </Grid>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" VerticalAlignment="Center" Text="Đang đọc danh sách ứng dụng…" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><Button x:Name="CancelScan" Grid.Column="1" Content="Dừng quét" Padding="12,5" Visibility="Collapsed"/></Grid>
  </Grid>
 </Grid>
</Window>
